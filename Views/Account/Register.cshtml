@model SecurePass.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Secure Vault Account";
    Layout = "_AuthLayout";
}

<div class="auth-card-container" style="max-width: 1100px;">
    <!-- Left Hero Pane -->
    <div class="auth-hero-pane">
        <div>
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="brand-icon" style="width: 44px; height: 44px; font-size: 1.5rem;">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h3 class="brand-text m-0">SecurePass</h3>
                    <small class="text-muted">Zero-Knowledge Encrypted Vault</small>
                </div>
            </div>
            <h2 class="text-theme-primary fw-bold mb-3">Begin Zero-Trust Defense</h2>
            <p class="text-secondary" style="font-size: 0.95rem; line-height: 1.6;">
                Create your isolated password vault. Your master password is never stored in plain text and is encrypted using BCrypt with cryptographic salts.
            </p>
        </div>

        <div class="mt-4">
            <div class="d-flex flex-column gap-2 text-secondary small">
                <div class="d-flex align-items-center gap-2"><i class="fa-solid fa-check text-success"></i> Client & Server End-to-End Encryption</div>
                <div class="d-flex align-items-center gap-2"><i class="fa-solid fa-check text-success"></i> Live Entropy & Brute-Force Crack Estimator</div>
                <div class="d-flex align-items-center gap-2"><i class="fa-solid fa-check text-success"></i> 90-Day Expiry & Credential Reuse Auditing</div>
            </div>
        </div>
    </div>

    <!-- Right Register Form -->
    <div class="auth-form-pane">
        <div class="mb-3">
            <h3 class="text-theme-primary fw-bold">Create Secure Account</h3>
            <p class="text-secondary small">Setup your master credentials to initialize your private vault.</p>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6 cyber-form-group mb-2">
                    <label asp-for="FullName" class="cyber-label">Full Name</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-user input-icon"></i>
                        <input asp-for="FullName" id="regFullName" class="cyber-input" placeholder="Alex Morgan" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6 cyber-form-group mb-2">
                    <label asp-for="Email" class="cyber-label">Email Address</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-envelope input-icon"></i>
                        <input asp-for="Email" id="regEmail" class="cyber-input" placeholder="alex@domain.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6 cyber-form-group mb-2">
                    <label asp-for="Password" class="cyber-label">Master Password</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-lock input-icon"></i>
                        <input asp-for="Password" type="password" id="regPassword" class="cyber-input" placeholder="Min. 8 characters" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-md-6 cyber-form-group mb-2">
                    <label asp-for="ConfirmPassword" class="cyber-label">Confirm Password</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-shield-halved input-icon"></i>
                        <input asp-for="ConfirmPassword" type="password" class="cyber-input" placeholder="Repeat master password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <!-- Live Strength Meter -->
            <div class="strength-meter-container mb-3">
                <div class="strength-bar-track">
                    <div class="strength-bar-fill" id="regStrengthBar"></div>
                </div>
                <div class="strength-meta">
                    <span class="strength-text" id="regStrengthText">Empty</span>
                    <span class="strength-score-label" id="regScoreText">0/100</span>
                </div>
            </div>

            <!-- Live Checklist -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <div class="rule-item" id="rule-min-length">
                        <div class="rule-icon"><i class="fa-solid fa-xmark"></i></div>
                        <span class="small">8+ Characters</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="rule-item" id="rule-upper">
                        <div class="rule-icon"><i class="fa-solid fa-xmark"></i></div>
                        <span class="small">Uppercase (A–Z)</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="rule-item" id="rule-numbers">
                        <div class="rule-icon"><i class="fa-solid fa-xmark"></i></div>
                        <span class="small">Numbers (0–9)</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="rule-item" id="rule-symbols">
                        <div class="rule-icon"><i class="fa-solid fa-xmark"></i></div>
                        <span class="small">Special Symbols</span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="d-flex align-items-center gap-2 text-secondary small" style="cursor: pointer;">
                    <input asp-for="AcceptTerms" type="checkbox" class="form-check-input bg-dark border-secondary m-0" />
                    <span>I agree to the Security Terms & Conditions</span>
                </label>
                <span asp-validation-for="AcceptTerms" class="text-danger small d-block"></span>
            </div>

            <button type="submit" class="btn-cyber-success w-100 justify-content-center py-2 mb-3">
                <i class="fa-solid fa-lock"></i> Register Master Vault
            </button>

            <div class="text-center">
                <span class="text-muted small">Already have an account?</span>
                <a asp-action="Login" class="text-decoration-none fw-semibold text-primary ms-1 small">Sign In</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            bindPasswordStrengthChecker({
                inputSelector: '#regPassword',
                barSelector: '#regStrengthBar',
                strengthTextSelector: '#regStrengthText',
                scoreTextSelector: '#regScoreText',
                personalInfoSelector: '#regFullName'
            });
        });
    </script>
}

