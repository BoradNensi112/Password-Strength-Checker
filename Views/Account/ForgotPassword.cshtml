@model SecurePass.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Account Recovery";
    Layout = "_AuthLayout";
}

<div class="auth-card-container" style="max-width: 600px; grid-template-columns: 1fr;">
    <div class="auth-form-pane p-5">
        <div class="text-center mb-4">
            <div class="brand-icon mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.8rem;">
                <i class="fa-solid fa-key"></i>
            </div>
            <h3 class="text-theme-primary fw-bold">Master Password Recovery</h3>
            <p class="text-secondary small">Enter your verified recovery email address to receive password reset tokens.</p>
        </div>

        @if (ViewBag.Submitted == true)
        {
            <div class="cyber-alert cyber-alert-success text-center flex-column py-4">
                <i class="fa-solid fa-paper-plane fs-2 mb-2 text-success"></i>
                <h5 class="text-theme-primary fw-bold mb-1">Recovery Instructions Sent</h5>
                <p class="text-secondary small mb-3">If an account is associated with <strong>@ViewBag.Email</strong>, you will receive a secure reset link.</p>
                <a asp-action="Login" class="btn-cyber-primary btn-sm">Return to Login</a>
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="cyber-form-group">
                    <label asp-for="Email" class="cyber-label">Your Email Address</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-envelope input-icon"></i>
                        <input asp-for="Email" class="cyber-input" placeholder="user@domain.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-cyber-primary w-100 justify-content-center py-2 mb-3">
                    <i class="fa-solid fa-shield-halved"></i> Send Reset Link
                </button>

                <div class="text-center">
                    <a asp-action="Login" class="text-decoration-none small text-muted"><i class="fa-solid fa-arrow-left me-1"></i> Back to Login</a>
                </div>
            </form>
        }
    </div>
</div>

