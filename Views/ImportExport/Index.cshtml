@model SecurePass.Models.ViewModels.ImportExportViewModel
@{
    ViewData["Title"] = "Import & Export Passwords";
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-file-import"></i> Import & Export Data</h1>
        <p class="page-subtitle">Backup your encrypted vault or import credentials from external password managers</p>
    </div>
</div>

<div class="row g-4">
    <!-- Export Section -->
    <div class="col-lg-6">
        <div class="cyber-card h-100">
            <h5 class="text-theme-primary fw-bold mb-3"><i class="fa-solid fa-file-export me-2 text-primary"></i> Export Vault Credentials</h5>
            <p class="text-secondary small mb-4">
                Download a secure decrypted snapshot or portable backup of your stored accounts. Keep exported files securely in an encrypted drive.
            </p>

            <div class="d-flex flex-column gap-3 mb-4">
                <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background: rgba(8, 14, 30, 0.6); border: 1px solid var(--border-color);">
                    <div>
                        <div class="text-theme-primary fw-semibold"><i class="fa-solid fa-file-csv text-success me-2"></i> CSV Spreadsheet (.csv)</div>
                        <div class="text-muted small">Standard format compatible with Excel, Google Sheets, Bitwarden, 1Password</div>
                    </div>
                    <a asp-action="ExportCsv" class="btn btn-sm btn-cyber-primary py-2 px-3">
                        <i class="fa-solid fa-download"></i> Export CSV
                    </a>
                </div>

                <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background: rgba(8, 14, 30, 0.6); border: 1px solid var(--border-color);">
                    <div>
                        <div class="text-theme-primary fw-semibold"><i class="fa-solid fa-file-code text-info me-2"></i> JSON Data Backup (.json)</div>
                        <div class="text-muted small">Structured format with complete timestamps, notes, and metadata</div>
                    </div>
                    <a asp-action="ExportJson" class="btn btn-sm btn-cyber-outline py-2 px-3">
                        <i class="fa-solid fa-download"></i> Export JSON
                    </a>
                </div>
            </div>

            <div class="p-3 rounded-3" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3);">
                <div class="text-danger small fw-semibold"><i class="fa-solid fa-shield-halved me-1"></i> Security Warning</div>
                <div class="text-muted small" style="font-size: 0.8rem;">
                    Exported files contain plaintext passwords. Delete them after transferring to a secure offline vault.
                </div>
            </div>
        </div>
    </div>

    <!-- Import Section -->
    <div class="col-lg-6">
        <div class="cyber-card h-100">
            <h5 class="text-theme-primary fw-bold mb-3"><i class="fa-solid fa-file-import me-2 text-success"></i> Import Passwords via CSV</h5>
            <p class="text-secondary small mb-3">
                Bulk upload accounts from Chrome, Firefox, or other password managers into SecurePass AES-256 vault.
            </p>

            <form asp-action="ImportCsv" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="cyber-form-group mb-3">
                    <label class="cyber-label">Upload CSV File</label>
                    <input type="file" asp-for="CsvFile" class="form-control bg-dark text-theme-primary border-secondary" accept=".csv" required />
                    <span asp-validation-for="CsvFile" class="text-danger small"></span>
                </div>

                <div class="p-3 rounded-3 mb-4" style="background: rgba(8, 14, 30, 0.6); border: 1px solid var(--border-color);">
                    <div class="text-muted small mb-1 fw-bold">Supported CSV Header Structure:</div>
                    <code class="text-cyan small">Title,Website,Username,Password,Category,Notes</code>
                </div>

                <button type="submit" class="btn-cyber-success w-100 justify-content-center py-2">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload & Encrypt Passwords
                </button>
            </form>

            @if (Model.ImportMessages.Any())
            {
                <div class="mt-3 p-3 rounded-3" style="background: rgba(8, 14, 30, 0.6); max-height: 150px; overflow-y: auto;">
                    <h6 class="text-theme-primary small fw-bold mb-2">Import Log:</h6>
                    <ul class="list-unstyled small text-muted m-0">
                        @foreach (var msg in Model.ImportMessages)
                        {
                            <li>@msg</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

